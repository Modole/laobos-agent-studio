{
  "name": "laobos-agent-studio",
  "version": "0.3.10",
  "description": "劳博士：基于 DeepSeek Harness 的本地 Agent 桌面客户端",
  "author": "Modole contributors",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "ws": "8.21.3"
  },
  "scripts": {
    "postinstall": "patch-package && node scripts/ensure-node-pty-helper.mjs",
    "dev": "npm run build:desktop-plugins && node scripts/start-dsh.mjs",
    "dev:full": "npm run build:desktop-plugins && node scripts/start-dsh.mjs",
    "start": "npm run build:desktop-plugins && node scripts/start-dsh.mjs",
    "dump-config": "node scripts/start-dsh.mjs --dump-config",
    "audit:public": "node scripts/audit-public-release.mjs",
    "migrate:pi": "node scripts/migrate-pi.mjs",
    "build:desktop-plugins": "node scripts/build-desktop-plugins.mjs",
    "desktop:dev": "npm run build:desktop-plugins && electron .",
    "desktop:renderer:dev": "vite --config vite.desktop.config.ts",
    "desktop:renderer:build": "vite build --config vite.desktop.config.ts",
    "desktop:stage-pi": "node scripts/stage-pi-binary.mjs",
    "desktop:package": "npm run build:desktop-plugins && node scripts/package-desktop.mjs",
    "desktop:make": "npm run build:desktop-plugins && node scripts/make-desktop.mjs",
    "desktop:installer": "npm run build:desktop-plugins && electron-builder --publish never",
    "desktop:installer:test-update": "npm run build:desktop-plugins && electron-builder --config electron-builder.test-update.yml --publish never",
    "release:mac:test": "npm run desktop:installer:test-update -- --mac dmg zip --arm64",
    "site:dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "site:start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "pi:dev": "node scripts/dev-full.mjs",
    "pi:bridge": "node bridge/server.mjs",
    "test": "npm run build && npm run desktop:renderer:build && node --test tests/*.test.mjs",
    "test:dsh": "npm run build:desktop-plugins && node --test tests/dsh-*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@browserops/bridge": "^0.0.11",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.7",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.7",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-directory-picker-browse": "0.1.0-rc.7",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.7",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-directory-picker-browse": "0.1.0-rc.7",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.7",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.7",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.7",
    "@laobos/dsh-performance": "file:packages/laobos-performance",
    "@laobos/dsh-shell": "file:packages/laobos-shell",
    "@laobos/dsh-system-tools": "file:packages/laobos-system-tools",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "12.11.3",
    "electron-updater": "^6.8.9",
    "next": "16.2.11",
    "node-pty": "1.2.0-beta.15",
    "patch-package": "8.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "ssh2": "^1.17.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electron/asar": "4.2.1",
    "@electron/packager": "20.0.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "43.2.0",
    "electron-builder": "26.15.7",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.2.1",
    "wrangler": "4.92.0",
    "yauzl": "3.4.0"
  },
  "type": "module"
}
